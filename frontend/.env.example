# VOJAS Frontend — Environment Variables
# Copy this file to `.env.local` and fill in your values.
# All variables must be prefixed with VITE_ to be exposed to the client.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# App metadata (optional — used for branding, version display)
VITE_APP_NAME=VOJAS
VITE_APP_VERSION=1.0.0

# Toggle React Query devtools (default: enabled in dev only)
VITE_ENABLE_RQ_DEVTOOLS=true
