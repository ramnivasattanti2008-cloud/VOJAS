# VOJAS Frontend — Environment Variables
# Copy this file to `.env` and fill in real values.
# Vite reads these at build time — restart `npm run dev` after changes.

# Backend API base URL
VITE_API_URL=http://localhost:4000

# ── Monitoring ──────────────────────────────────────────────────────────
# Sentry — free tier: 5,000 events/month.
# Create a project at sentry.io, copy the DSN from Project Settings → Client
# Keys (React / Browser). Leave empty to disable Sentry.
VITE_SENTRY_DSN=

# ── Maps ────────────────────────────────────────────────────────────────
# Currently using OpenStreetMap tiles via Leaflet (free).
# Set to a Google Maps API key only if migrating to Google Maps Platform.
# WARNING: Google Maps requires a Google Cloud billing account — paid service.
# See docs/PAID-DEPENDENCIES.md before enabling.
VITE_GOOGLE_MAPS_API_KEY=
