# Node modules
node_modules/
package-lock.json
yarn.lock
pnpm-lock.json
npm-debug.log*

# Build outputs
**/dist/
**/build/
**/coverage/
**/.next/
**/.nuxt/
**/.cache/
**/.output/
**/.temp/
**/.local/
**/*.tsbuildinfo
**/tsconfig.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov*

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
*.orig
*~

# OS
.DS_Store
Thumbs.db

# Prisma
**/prisma/*.db
**/prisma/*.db-journal
**/prisma/prisma/
!**/prisma/schema.prisma

# User-uploaded attachments (served at runtime from /uploads)
backend/uploads/
apps/api/uploads/
!**/uploads/.gitkeep

# Large data files (ingest sources — not needed in repo)
backend/mps_17th.json
backend/mps_affidavits.csv
backend/mps_list.csv
backend/data/

# Docker
# .dockerignore is NOT ignored — it belongs in the repo so every build
# environment (local, CI, Render) excludes node_modules/.env/etc. from the
# build context consistently. Ignoring it here silently defeated that.
docker-compose.*.override.yml

# Misc
.cache
.temp
.sass-cache
.vercel
.env*
