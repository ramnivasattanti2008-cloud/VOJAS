NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://vojas:vojas_dev@localhost:5432/vojas_dev
DATABASE_URL_TEST=postgresql://vojas:vojas_dev@localhost:5432/vojas_test
JWT_SECRET=replace-with-32-char-random-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Satellite / Earth Observation (M5)
# Get OAuth2 credentials at https://dataspace.copernicus.eu/
# Without these, satellite endpoints return NO_USABLE_OBSERVATION / AUTHENTICATION_REQUIRED.
SATELLITE_PROVIDER=cdse
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SATELLITE_CLOUD_THRESHOLD=60
SATELLITE_SEARCH_WINDOW_DAYS=14
