{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": false,
    "noEmitOnError": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@vojas/db": ["../../packages/db/dist"],
      "@vojas/domain": ["../../packages/domain/dist"],
      "@vojas/shared": ["../../packages/shared/dist"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "../../packages/**",
    "../../frontend/**"
  ]
}
