{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "declaration": false,
    "noEmitOnError": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@vojas/db": ["../../packages/db/src"],
      "@vojas/domain": ["../../packages/domain/src"],
      "@vojas/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
