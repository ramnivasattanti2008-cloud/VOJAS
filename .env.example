# ============================================================
# VOJAS Environment Configuration
# ============================================================
# Copy this file to .env for development:
#   cp .env.example .env
#
# For production (Docker), set these via environment variables
# or a secrets manager (AWS Secrets Manager, Render env vars,
# GitHub Actions Secrets, etc.). NEVER commit .env to version
# control. Use .gitignore to exclude .env files.
# ============================================================

# ── Backend ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────────
# VOJAS requires PostgreSQL with the PostGIS extension. Do not change this to SQLite.
# The local Docker database uses the values below; replace the password for shared environments.
POSTGRES_USER=vojas
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_DB=vojas
DATABASE_URL=postgresql://vojas:change-this-local-development-password@localhost:5432/vojas?schema=public
# Test database (create separately before integration tests):
DATABASE_URL_TEST=postgresql://vojas:change-this-local-development-password@localhost:5432/vojas_test?schema=public

# ── Authentication ────────────────────────────────────────────────────────────────
# REQUIRED: JWT secret must be a strong random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_GENERATE_WITH_NODE
JWT_EXPIRES_IN=7d

# Bcrypt cost factor for password hashing (10-14 recommended; higher = safer but slower).
# Default: 12. Increase to 14 for production with low user counts.
BCRYPT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. This is what apps/api reads.
# For production, use specific domain names only (no wildcards) — e.g. the
# Vercel domain of the web app.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public base URL of the web app. Used when the API needs to build absolute
# links back to the frontend.
CLIENT_BASE_URL=http://localhost:3000

# ── Sentry (Optional — server-side error monitoring) ──────────────────────────
# Leave blank to disable Sentry entirely (graceful no-op in code).
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_DSN=

# ── Storage ────────────────────────────────────────────────────────────────────
# Local storage directory for uploads.
UPLOAD_DIR=./uploads
# Maximum file upload size in bytes (default: 25MB)
UPLOAD_MAX_SIZE=26214400

# ── Satellite Earth Observation (Phase 53 / M5) ─────────────────────────────────
# Copernicus Data Space Ecosystem — register at https://dataspace.copernicus.eu/
# Free tier: 10k PU/month, 300 req/min. No credit card required.
# When these are blank the satellite endpoints return an explicit
# NOT_CONFIGURED / AUTHENTICATION_REQUIRED state. They never synthesise
# observations or spectral indices.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Max cloud cover %, and the ± day window, used when selecting a Sentinel-2 scene.
SATELLITE_CLOUD_THRESHOLD=60
SATELLITE_SEARCH_WINDOW_DAYS=14
# Set to true to force stub mode (only stored observations used).
SATELLITE_STUB_MODE=true

# ── Redis (M19: BullMQ + distributed cache) ─────────────────────────────────────
# Used for the satellite job queue and distributed cache.
# If unset, the API uses in-memory implementations (suitable for local dev;
# NOT suitable for multi-instance production — use Redis for that).
#
# Local Redis: redis://localhost:6379
# Upstash Redis (free tier): redis://default:xxxx@xxx.upstash.io:6379
# Render Key Value: redis://localhost:6379 (Render KV auto-maps this internally)
#REDIS_URL=redis://localhost:6379

# ── Optional External APIs ─────────────────────────────────────────────────────
# Leave blank to use free/built-in alternatives.
# GOOGLE_MAPS_API_KEY=
# BHUVAN_API_KEY=
# DATA_GOV_API_KEY=

# ── Frontend (Next.js — apps/web, deployed on Vercel) ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Optional: Sentry DSN for browser-side error monitoring.
# Must be a public DSN (safe to expose to client).
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# NEXT_PUBLIC_SENTRY_DSN=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# General rate limit (requests per 15 minutes per IP).
# RATE_LIMIT_GENERAL=300

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=info  (options: trace, debug, info, warn, error, fatal)

# ── Demo / Seeding ─────────────────────────────────────────────────────────────
# The API never seeds or migrates on startup — nothing in apps/api reads a
# seed-on-boot flag. Seeding is an explicit, separate operation:
#   pnpm db:migrate     (or `prisma migrate deploy` in a deploy step)
#   pnpm db:seed
