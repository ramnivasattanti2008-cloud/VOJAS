# ============================================================
# VOJAS Environment Configuration
# ============================================================
# Copy this file to .env for development:
#   cp .env.example .env
#
# For production (Docker), set these via environment variables
# or a secrets manager. Never commit .env to version control.
# ============================================================

# ── Backend ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_BASE_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=file:./prisma/dev.db

# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://vojas:change-password@localhost:5432/vojas

# ── Authentication ────────────────────────────────────────────────────────────────
# MUST be a strong random string in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Docker / Demo seeding ────────────────────────────────────────────────────────
# Set to "true" to auto-seed the database on first backend boot (only when DB is empty).
# Recommended for staging / demo. Leave false for production.
SEED_ON_BOOT=false

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# These are embedded into the Vite build at compile time.
# Changing them requires a frontend rebuild.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=VOJAS

# ── Maps ────────────────────────────────────────────────────────────────────────
# Leaflet — free, open-source, no API key required.
VITE_MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ── External API Keys (optional) ────────────────────────────────────────────────
# Leave blank to use free/built-in alternatives.
GOOGLE_MAPS_API_KEY=
BHUVAN_API_KEY=
DATA_GOV_API_KEY=

# ── Satellite Earth Observation (Phase 53) ─────────────────────────────────────
# Copernicus Data Space Ecosystem — register at https://dataspace.copernicus.eu/
# OAuth2 client_credentials. Free tier: 10k PU/month, 300 req/min.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Optional: Google Earth Engine Python service (future)
# GEE_SERVICE_URL=http://localhost:8001
# GEE_SERVICE_KEY=
# Force the satellite service to "stub mode" if no CDSE creds (uses only stored observations, no live queries)
SATELLITE_STUB_MODE=true
