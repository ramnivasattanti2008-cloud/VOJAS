# ============================================================
# VOJAS Environment Configuration
# ============================================================
# Copy this file to .env for development:
#   cp .env.example .env
#
# For production (Docker), set these via environment variables
# or a secrets manager (AWS Secrets Manager, Render env vars,
# GitHub Actions Secrets, etc.). NEVER commit .env to version
# control. Use .gitignore to exclude .env files.
# ============================================================

# ── Backend ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=file:./prisma/dev.db

# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql://vojas:CHANGE_PASSWORD@localhost:5432/vojas

# Test database (for integration tests with DATABASE_URL_TEST):
# DATABASE_URL_TEST=postgresql://vojas:CHANGE_PASSWORD@localhost:5432/vojas_test

# ── Authentication ────────────────────────────────────────────────────────────────
# REQUIRED: JWT secret must be a strong random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_GENERATE_WITH_NODE
JWT_EXPIRES_IN=7d

# Bcrypt cost factor for password hashing (10-14 recommended; higher = safer but slower).
# Default: 12. Increase to 14 for production with low user counts.
BCRYPT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# For production, use specific domain names only (no wildcards).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Storage ────────────────────────────────────────────────────────────────────
# Local storage directory for uploads.
UPLOAD_DIR=./uploads
# Maximum file upload size in bytes (default: 25MB)
UPLOAD_MAX_SIZE=26214400

# ── Satellite Earth Observation (Phase 53 / M5) ─────────────────────────────────
# Copernicus Data Space Ecosystem — register at https://dataspace.copernicus.eu/
# Free tier: 10k PU/month, 300 req/min. No credit card required.
# Leave blank to use stub mode (no live satellite queries).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Set to true to force stub mode (only stored observations used).
SATELLITE_STUB_MODE=true

# ── Optional External APIs ─────────────────────────────────────────────────────
# Leave blank to use free/built-in alternatives.
# GOOGLE_MAPS_API_KEY=
# BHUVAN_API_KEY=
# DATA_GOV_API_KEY=

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=VOJAS

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# General rate limit (requests per 15 minutes per IP).
# RATE_LIMIT_GENERAL=300

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=info  (options: trace, debug, info, warn, error, fatal)

# ── Demo / Seeding ─────────────────────────────────────────────────────────────
# Set to "true" to auto-seed the database on first backend boot (only when DB is empty).
# Recommended for staging / demo. Leave false for production.
SEED_ON_BOOT=false
