NODE_ENV=development
APP_NAME=VOJAS

# Database
DATABASE_URL=postgresql://vojas:vojas_dev@localhost:5432/vojas_dev
DATABASE_URL_TEST=postgresql://vojas:vojas_dev@localhost:5432/vojas_test

# Auth
JWT_SECRET=replace-with-32-char-random-secret-replace-me
JWT_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Optional providers (leave empty to use null provider)
SATELLITE_PROVIDER=
MAPS_PROVIDER=
AI_PROVIDER=
GOVERNMENT_DATA_PROVIDER=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
