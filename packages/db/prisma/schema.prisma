// ────────────────────────────────────────────────────────────
// RISK & VERIFICATION
// ────────────────────────────────────────────────────────────

// ────────────────────────────────────────────────────────────
// RISK FINDING — M8 Multi-Signal AI Risk & Anomaly Engine
// ────────────────────────────────────────────────────────────
// Supports all statuses: NEW, ACKNOWLEDGED, UNDER_REVIEW, VERIFICATION_REQUIRED, RESOLVED, DISMISSED, ESCALATED
// Risk score 0-100, confidence LOW|MEDIUM|HIGH, algorithm version for auditability
// ────────────────────────────────────────────────────────────
model RiskFinding {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  type             String   // finding type e.g. "PROGRESS_SATELLITE_MISMATCH", "COST_ANOMALY"
  title            String
  description      String
  severity         AnomalySeverity @default(MEDIUM)
  riskScore        Int   @default(0) @map("risk_score") // 0-100
  confidence       String @default("MEDIUM") // LOW | MEDIUM | HIGH
  status           RiskFindingStatus @default(NEW)
  recommendedAction String? @map("recommended_action")
  limitations      String? @map("limitations")
  signalIds        String[] @default([]) @map("signal_ids") // IDs of contributing RiskSignal records
  evidence         Json?
  algorithmVersion String @default("rule-engine-v1.0") @map("algorithm_version")
  firstObservedAt  DateTime? @map("first_observed_at") @db.Timestamptz(6)
  lastObservedAt   DateTime? @map("last_observed_at") @db.Timestamptz(6)
  detectedAt       DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Assignment
  assignedToId     String? @map("assigned_to_id")
  acknowledgedById String? @map("acknowledged_by_id")
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  resolvedById     String? @map("resolved_by_id")
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolution       String?

  // Law escalation
  lawEscalation    Boolean @default(false) @map("law_escalation")
  lawAuthority     String? @map("law_authority")

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo     User? @relation("RiskFindingAssignedTo", fields: [assignedToId], references: [id])
  acknowledgedBy User? @relation("RiskFindingAcknowledgedBy", fields: [acknowledgedById], references: [id])
  resolvedBy     User? @relation("RiskFindingResolvedBy", fields: [resolvedById], references: [id])
  cases          VerificationCase[]

  @@index([projectId])
  @@index([status])
  @@index([severity])
  @@index([riskScore])
  @@index([confidence])
  @@index([algorithmVersion])
  @@index([type, projectId])
  @@index([type, status, severity]) // compound for risk dashboard filtering
  @@index([detectedAt])
  @@map("risk_findings")
}

model VerificationCase {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  findingId    String?  @map("finding_id")
