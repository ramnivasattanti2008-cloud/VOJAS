// ────────────────────────────────────────────────────────────
// AUDIT (APPEND-ONLY)
// ────────────────────────────────────────────────────────────
// AuditEvent is immutable: no UPDATE or DELETE routes must exist.
// The service layer (auditService.ts) enforces append-only semantics.
// ────────────────────────────────────────────────────────────

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String      @map("actor_id") // userId, "SYSTEM", or "AI"
  actorType  String      @map("actor_type") // USER | SYSTEM | AI | EXTERNAL
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  timestamp  DateTime    @default(now()) @db.Timestamptz(6)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_events")
}

// ────────────────────────────────────────────────────────────
// SIGNAL TYPES (M8 normalized signal architecture)
// ────────────────────────────────────────────────────────────
// Each signal represents an independent data point that can
// contribute to a risk finding. Source diversity drives confidence.
//
// Supported signal types:
//   SATELLITE_CHANGE — satellite observation mismatch
//   PROGRESS_FINANCIAL_MISMATCH — expenditure vs progress
//   PROJECT_DELAY — milestone date passed, low progress
//   COST_ANOMALY — cost vs peer benchmark
//   DUPLICATE_PROJECT — possible duplicate project
//   GEOGRAPHIC_INCONSISTENCY — location mismatch
//   DOCUMENT_INCONSISTENCY — document contradictions
//   CITIZEN_OFFICIAL_DISCREPANCY — report vs status
//   CONTRACTOR_PATTERN — cross-project patterns
//   ENVIRONMENTAL_RISK — environmental anomaly
// ────────────────────────────────────────────────────────────
enum SignalType {
  SATELLITE_CHANGE
  PROGRESS_FINANCIAL_MISMATCH
  PROJECT_DELAY
  COST_ANOMALY
  DUPLICATE_PROJECT
  GEOGRAPHIC_INCONSISTENCY
  DOCUMENT_INCONSISTENCY
  CITIZEN_OFFICIAL_DISCREPANCY
  CONTRACTOR_PATTERN
  ENVIRONMENTAL_RISK
}

// ────────────────────────────────────────────────────────────
// RISK FINDING STATUS
// ────────────────────────────────────────────────────────────
enum RiskFindingStatus {
  NEW
  ACKNOWLEDGED
  UNDER_REVIEW
  VERIFICATION_REQUIRED
  RESOLVED
  DISMISSED
  ESCALATED
}

// ────────────────────────────────────────────────────────────
// RISK RULE STATUS
// ────────────────────────────────────────────────────────────
enum RiskRuleStatus {
  ENABLED
  DISABLED
}

// ────────────────────────────────────────────────────────────
// RISK SIGNAL — normalized independent evidence
// ────────────────────────────────────────────────────────────
model RiskSignal {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  signalType       SignalType
  sourceType       String   // e.g. "satellite", "financial_record", "document", "citizen", "contractor", "field_verification"
  sourceId         String?  // ID of the originating record
  detectedAt       DateTime @map("detected_at") @db.Timestamptz(6)
  observationDate  DateTime? @map("observation_date") @db.Timestamptz(6)
  severity         String   // LOW | MEDIUM | HIGH | CRITICAL
  confidence       String   // LOW | MEDIUM | HIGH
  value            Float?
  expectedValue    Float?
  deviation        Float?
  explanation      String?
  evidenceReferences Json?  // array of evidence record IDs
  metadata         Json?    // algorithm version, parameters, etc.
  algorithmVersion String    @default("rule-engine-v1.0") @map("algorithm_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([signalType])
  @@index([severity])
  @@index([confidence])
  @@index([detectedAt])
  @@index([projectId, signalType, detectedAt]) // compound for risk engine
  @@map("risk_signals")
}

// ────────────────────────────────────────────────────────────
// RISK RULE — deterministic rule definitions
// ────────────────────────────────────────────────────────────
model RiskRule {
  id               String   @id @default(cuid())
  name             String
  category         String   // e.g. "progress_satellite_mismatch", "cost_anomaly"
  version          String   @default("v1.0")
  status           RiskRuleStatus @default(ENABLED)
  conditions       Json      // rule condition logic as structured JSON
  severityModifier String   // added to base score: LOW=+0, MEDIUM=+5, HIGH=+15, CRITICAL=+30
  confidenceModifier String  // "LOW" | "MEDIUM" | "HIGH"
  explanationTemplate String  // mustache template with {{variable}} placeholders
  enabled          Boolean  @default(true)
  lastRun          DateTime? @map("last_run") @db.Timestamptz(6)
  matchCount       Int      @default(0) @map("match_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions          RiskRuleVersion[]

  @@index([category])
  @@index([status])
  @@index([version])
  @@map("risk_rules")
}

// ────────────────────────────────────────────────────────────
// RISK RULE VERSION — versioned rule algorithm revisions
// ────────────────────────────────────────────────────────────
model RiskRuleVersion {
  id               String   @id @default(cuid())
  ruleId           String   @map("rule_id")
  version          String
  conditions       Json      // conditions for this version
  severityModifier String
  confidenceModifier String
  explanationTemplate String
  effectiveAt      DateTime @map("effective_at") @db.Timestamptz(6)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  riskRule         RiskRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, version])
  @@index([ruleId, isActive])
  @@map("risk_rule_versions")
}

// ────────────────────────────────────────────────────────────
// RISK EVENT — project risk timeline (M13)
// ────────────────────────────────────────────────────────────
model RiskEvent {
  id               String   @id @default(cuid())
  projectId        String   @map("project_id")
  eventType        String   // e.g. "finding_detected", "score_updated", "rule_triggered", "verification_complete"
  description      String
  severity         String   // LOW | MEDIUM | HIGH | CRITICAL
  riskScore        Int?     // 0-100 if score change
  findingId        String?  @map("finding_id") // related RiskFinding
  relatedSignalIds Json?    // signal IDs that triggered this event
  metadata         Json?    // additional event context
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([eventType])
  @@index([findingId])
  @@map("risk_events")
}

// ────────────────────────────────────────────────────────────
// ANOMALIES (legacy-compatible; RiskFinding remains the canonical M1 model)
// ────────────────────────────────────────────────────────────

model Anomaly {
  id               String          @id @default(cuid())
  title            String
  description      String
  category         AnomalyCategory
  severity         AnomalySeverity @default(MEDIUM)
  riskScore        Int             @default(50) @map("risk_score")
  status           String          @default("OPEN") // OPEN | ACKNOWLEDGED | UNDER_INVESTIGATION | RESOLVED | ESCALATED | DISMISSED
  ruleCode         String?         @map("rule_code")
  projectId        String?         @map("project_id")
  reportId         String?         @map("report_id")
  vendorId         String?         @map("vendor_id")
  evidence         Json?
  acknowledgedById String?         @map("acknowledged_by_id")
  acknowledgedAt   DateTime?       @map("acknowledged_at") @db.Timestamptz(6)
  resolvedById     String?         @map("resolved_by_id")
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolution       String?
  // Law enforcement escalation
  lawEscalation    Boolean         @default(false) @map("law_escalation")
  lawAuthority     String?         @map("law_authority")
  lawReferenceNo   String?         @map("law_reference_no")
  lawEscalatedAt   DateTime?       @map("law_escalated_at") @db.Timestamptz(6)
  lawEscalatedById String?         @map("law_escalated_by_id")
  lawAcknowledged  Boolean         @default(false) @map("law_acknowledged")
  lawNotes         String?         @map("law_notes")
  // AI explanation
  aiExplanation    String?         @map("ai_explanation")
  aiConfidence     Int?            @map("ai_confidence")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  acknowledgedBy User?    @relation("AnomalyAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedBy     User?    @relation("AnomalyResolver", fields: [resolvedById], references: [id])
