  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([projectId])
  @@index([createdAt])
  @@index([ruleCode])
  @@index([lawEscalation, lawAuthority])
  @@index([projectId, ruleCode, status])
  @@map("anomalies")
}

