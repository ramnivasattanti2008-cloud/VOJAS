// ────────────────────────────────────────────────────────────
// CITIZEN REPORTS
// ────────────────────────────────────────────────────────────

model Report {
  id            String         @id @default(cuid())
  reportReference String       @unique @map("report_reference") // e.g. VOJAS-2026-XXXX
  title         String
  description   String
  category      ReportCategory
  severity      ReportSeverity @default(LOW)
  status        ReportStatus   @default(RECEIVED)
  // Reporter info
  reporterName  String?        @map("reporter_name")
  reporterEmail String?        @map("reporter_email")
  reporterPhone String?        @map("reporter_phone")
  isAnonymous   Boolean        @default(false) @map("is_anonymous")
  // Privacy
  privacyLevel ReportPrivacyLevel @default(RESTRICTED) @map("privacy_level")
  // Location
  locationDesc  String?        @map("location_desc")
  latitude      Float?
  longitude     Float?
  locationAccuracyM Float?    @map("location_accuracy_m")
  // Dates
  incidentDate DateTime?      @map("incident_date") @db.Timestamptz(6)
  submittedAt  DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  // AI / triage
  triageStatus ReportTriageStatus @default(PENDING) @map("triage_status")
  aiTriage    Json?          @map("ai_triage") // { suggestedCategory, suggestedPriority, matchedProjectIds, duplicateReportIds, extractedClaims }
  aiAnalyzedAt DateTime?     @map("ai_analyzed_at") @db.Timestamptz(6)
  // Evidence quality
  evidenceQuality ReportEvidenceQuality? @map("evidence_quality")
  // References
  projectId     String?        @map("project_id")
  assignedToId  String?        @map("assigned_to_id")
  resolution    String?
  resolvedAt    DateTime?      @map("resolved_at") @db.Timestamptz(6)
  // Source metadata
  source        String         @default("WEB")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  // Whistleblower
  whistleblowerToken String?   @map("whistleblower_token")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo  User?             @relation("ReportAssignee", fields: [assignedToId], references: [id])
  media       ReportMedia[]
  claims      CitizenClaim[]
  moderations ReportModeration[]
  statusLogs  ReportStatusLog[]

  @@index([reportReference])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([triageStatus])
  @@index([projectId])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([latitude, longitude])
  @@index([source])
  @@map("reports")
}

model ReportStatusLog {
  id          String        @id @default(cuid())
  reportId    String        @map("report_id")
  fromStatus  ReportStatus? @map("from_status")
  toStatus    ReportStatus  @map("to_status")
  changedById String?       @map("changed_by_id")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_status_logs")
}

// ────────────────────────────────────────────────────────────
// CITIZEN REPORT MEDIA (M10)
// ────────────────────────────────────────────────────────────

model ReportMedia {
  id               String    @id @default(cuid())
  reportId         String    @map("report_id")
  filename         String
  originalName     String    @map("original_name")
  mimeType         String    @map("mime_type")
  size             Int
  url              String
  mediaType        String    @map("media_type") // IMAGE | VIDEO | AUDIO | DOCUMENT
  // Privacy-aware metadata
  captureDate      DateTime? @map("capture_date") @db.Timestamptz(6)
  captureLat       Float?    @map("capture_lat")
  captureLng       Float?    @map("capture_lng")
  stripLocation    Boolean   @default(false) @map("strip_location") // metadata stripped for public view
  // Forensic signals (not accusations)
  forensicStatus   String    @default("PENDING") @map("forensic_status") // PENDING | REVIEW_REQUIRED | CLEAN | ANOMALY_DETECTED
  forensicSignals  Json?     @map("forensic_signals") // { metadataInconsistency, timestampInconsistency, duplicateMedia, perceptualSimilarity, manipulationIndicators, compressionAnomalies }
  verifiedById     String?   @map("verified_by_id")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
