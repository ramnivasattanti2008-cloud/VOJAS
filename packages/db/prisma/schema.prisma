  dataCoverage        Float    @default(0) @map("data_coverage")
  lastUpdated         DateTime @default(now()) @map("last_updated") @db.Timestamptz(6)
  modelVersion        String   @default("analytics-v1.0") @map("model_version")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([avgRiskScore])
  @@index([avgDelayDays])
  @@map("contractor_metrics")
}

