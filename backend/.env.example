# ── VOJAS backend environment variables ─────────────────────────────────────
# Copy this file to `.env` and fill in the values for your environment.
# Do NOT commit the real `.env` to source control.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
# Development (SQLite — local file)
DATABASE_URL=file:./prisma/dev.db

# Production (PostgreSQL)
# DATABASE_URL=postgresql://vojas:STRONG_PASSWORD@db:5432/vojas?schema=public

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# IMPORTANT: JWT_SECRET must be at least 32 characters. The app refuses to
# start in production with a shorter value.
JWT_SECRET=replace-with-a-32-plus-char-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── CORS ───────────────────────────────────────────────────────────────────
# Allowed origin for the frontend. Comma-separated for multiple. * is not allowed in prod.
CLIENT_BASE_URL=http://localhost:5173

# ── Uploads ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
