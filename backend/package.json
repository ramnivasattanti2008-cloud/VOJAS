{
  "name": "vojas-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "ingest:lgd": "tsx ../scripts/ingest/lgd.ts",
    "ingest:vonter": "tsx ../scripts/ingest/vonter.ts",
    "ingest:dataful": "tsx ../scripts/ingest/dataful.ts",
    "ingest:opencity": "tsx ../scripts/ingest/opencity.ts",
    "ingest:normalize": "tsx ../scripts/ingest/normalize.ts",
    "ingest:all": "npm run ingest:lgd && npm run ingest:vonter && npm run ingest:opencity && npm run ingest:dataful && npm run ingest:normalize"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  }
}
